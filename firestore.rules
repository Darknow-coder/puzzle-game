rules_version = '2';

// Lumignons — security rules of the online rankings (Cloud Firestore).
//
// Paste this whole file in the Firebase console (Firestore Database → Rules →
// Publish), or deploy it with `firebase deploy --only firestore:rules`.
// See docs/FIREBASE.md. The two tables at the end are written by
// tools/build-rules.mjs from the game's levels: run it after changing levels.
//
// What is stored, all of it public to read:
//   names/{key}                  who owns a pseudo (key = the pseudo folded:
//                                "Lune-Rêveuse" → "lunereveuse"), so it is unique
//   players/{uid}                pseudo, look of the player's Lumignon, total of stars
//   boards/{board}/entries/{uid} best result of a player on a level or daily puzzle
// Write-only: reports/{id} (a pseudo reported by a player).
// Never written by the game: banned/{uid} (create it by hand to ban a player).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }
    function playerPath(uid) {
      return /databases/$(database)/documents/players/$(uid);
    }

    // ------------------------------------------------------------ pseudos
    // Same shape and same folding as src/online/names.js.

    function validName(n) {
      return n is string
        && n.matches("^[A-Za-z0-9À-ÖØ-öø-ÿŒœ][A-Za-z0-9À-ÖØ-öø-ÿŒœ '._-]{1,16}[A-Za-z0-9À-ÖØ-öø-ÿŒœ]$")
        && !n.matches("^.*[ '._-][ '._-].*$");
    }
    function foldKey(n) {
      return n.lower()
        .replace('[àáâãäåÀÁÂÃÄÅ]', 'a')
        .replace('[æÆ]', 'ae')
        .replace('[çÇ]', 'c')
        .replace('[èéêëÈÉÊË]', 'e')
        .replace('[ìíîïÌÍÎÏ]', 'i')
        .replace('[ðÐ]', 'd')
        .replace('[ñÑ]', 'n')
        .replace('[òóôõöøÒÓÔÕÖØ]', 'o')
        .replace('[ùúûüÙÚÛÜ]', 'u')
        .replace('[ýÿÝ]', 'y')
        .replace('[þÞ]', 'th')
        .replace('ß', 'ss')
        .replace('[œŒ]', 'oe')
        .replace('[^a-z0-9]', '');
    }

    match /names/{key} {
      allow read: if true;
      // Taking a pseudo nobody has (an existing one would be an update: refused),
      // in the same write as the player's profile that uses it.
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && getAfter(playerPath(request.auth.uid)).data.key == key;
      // Giving it back: when the profile moves to another pseudo, or is deleted.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(playerPath(request.auth.uid))
          || getAfter(playerPath(request.auth.uid)).data.key != key);
    }

    // ------------------------------------------------------------ players

    function cosmetic(v) {
      return v is string && v.matches('^[a-z0-9-]{1,24}$');
    }
    function validProfile(uid, d) {
      let fields = ['name', 'key', 'color', 'hat', 'glasses', 'flame', 'stars', 'gkey', 'lastBoard', 'at', 'v'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && validName(d.name)
        && d.key == foldKey(d.name) && d.key.size() >= 3
        && d.color is int && d.color >= 0 && d.color <= 3
        && cosmetic(d.hat) && cosmetic(d.glasses) && cosmetic(d.flame)
        && d.stars is int && d.stars >= 0 && d.stars < 1000
        && d.gkey is int
        && d.lastBoard is string && d.lastBoard.size() <= 40
        && d.v is int
        && d.at == request.time
        && getAfter(/databases/$(database)/documents/names/$(d.key)).data.uid == uid;
    }
    // Global ranking key: (1000 − stars) × 10¹⁰ + the second the total was reached
    // (the device's clock, allowed ten minutes away from the server's).
    function gkeyFresh(d) {
      let second = d.gkey - (1000 - d.stars) * 10000000000;
      return second * 1000 > request.time.toMillis() - 600000
        && second * 1000 < request.time.toMillis() + 600000;
    }
    // The total of stars only changes with the result that changes it, in the same write.
    function starsJustified(uid, d) {
      return isLevel(d.lastBoard)
        && getAfter(/databases/$(database)/documents/boards/$(d.lastBoard)/entries/$(uid)).data.at == request.time;
    }

    match /players/{uid} {
      allow read: if true;
      allow create: if isMe(uid) && notBanned()
        && validProfile(uid, request.resource.data)
        && request.resource.data.stars == 0
        && request.resource.data.lastBoard == ''
        && gkeyFresh(request.resource.data);
      allow update: if isMe(uid) && notBanned()
        && validProfile(uid, request.resource.data)
        && (request.resource.data.stars == resource.data.stars
          ? request.resource.data.gkey == resource.data.gkey
          : starsJustified(uid, request.resource.data) && gkeyFresh(request.resource.data));
      allow delete: if isMe(uid);
    }

    // ------------------------------------------------------------ results
    // Same ranking key as src/online/score.js: more stars, fewer pieces, no hint,
    // fewer tries, less time.

    function isLevel(b) {
      return b.matches('^[1-9]-([1-9]|10|B)$');
    }
    function isDaily(b) {
      return b.matches('^d-20[0-9][0-9]-[01][0-9]-[0-3][0-9]-[a-z]{3,10}-[0-9]{1,2}$');
    }
    // A daily puzzle is ranked from the eve of its day (time zones) to three days later.
    function dailyOpen(b) {
      let p = b.split('-');
      let day = timestamp.date(int(p[1]), int(p[2]), int(p[3]));
      return request.time > day - duration.value(16, 'h') && request.time < day + duration.value(80, 'h');
    }
    function knownBoard(b, d) {
      let row = ':' + string(d.min) + ':' + string(d.par);
      return (isLevel(b) && (b + row) in levelTable().split(','))
        || (isDaily(b) && dailyOpen(b) && (b.split('-')[4] + '-' + b.split('-')[5] + row) in dailyTable().split(','));
    }
    function validEntry(b, d) {
      let fields = ['stars', 'pieces', 'helped', 'tries', 'ms', 'key', 'min', 'par', 'at', 'v'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.stars is int && d.stars >= 1 && d.stars <= 3
        && d.pieces is int && d.pieces >= 0 && d.pieces <= 63
        && d.min is int && d.par is int
        && knownBoard(b, d)
        // ★★★ = the fewest pieces with every firefly; ★★ = more pieces; ★ = at least the fewest to get home.
        && (d.stars == 3 ? d.pieces == d.par : (d.stars == 2 ? d.pieces > d.par : d.pieces >= d.min))
        && d.helped is bool
        && d.tries is int && d.tries >= 1 && d.tries <= 9999
        && d.ms is int && (d.ms == -1 || (d.ms >= 1000 && d.ms <= 99999999))
        && d.key == ((((3 - d.stars) * 64 + d.pieces) * 2 + (d.helped ? 1 : 0)) * 10000 + d.tries) * 100000000
          + (d.ms == -1 ? 99999999 : d.ms)
        && d.v is int
        && d.at == request.time;
    }
    // Campaign results add up to the player's total of stars, one level at a time.
    function starsFollow(uid, b, d) {
      return !isLevel(b)
        || getAfter(playerPath(uid)).data.stars
          == get(playerPath(uid)).data.stars + d.stars - (resource == null ? 0 : resource.data.stars);
    }

    match /boards/{board}/entries/{uid} {
      allow read: if true;
      allow create: if isMe(uid) && notBanned()
        && exists(playerPath(uid))
        && validEntry(board, request.resource.data)
        && starsFollow(uid, board, request.resource.data);
      // Only a better result replaces the one in place.
      allow update: if isMe(uid) && notBanned()
        && validEntry(board, request.resource.data)
        && request.resource.data.key < resource.data.key
        && starsFollow(uid, board, request.resource.data);
      // Results go away with the profile ("delete my online data").
      allow delete: if isMe(uid) && !existsAfter(playerPath(uid));
    }

    // ------------------------------------------------------------ reports

    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['target', 'board', 'by', 'at'])
        && request.resource.data.target is string && request.resource.data.target.size() <= 64
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }

    // ------------------------------------------------------------ tables
    // "board:fewest pieces to win:fewest pieces for ★★★", generated.

    // BEGIN TABLES
    function levelTable() {
      return '1-1:1:1,1-2:1:1,1-3:1:2,1-4:1:2,1-5:1:3,1-6:2:3,1-7:1:3,1-8:1:3,1-9:2:4,1-10:2:5,1-B:3:5,2-1:2:2,2-2:3:3,2-3:2:3,2-4:2:4,2-5:1:5,2-6:3:6,2-7:1:6,2-8:3:7,2-9:5:6,2-10:4:7,2-B:7:7,3-1:1:1,3-2:2:3,3-3:1:2,3-4:1:4,3-5:1:5,3-6:1:5,3-7:1:6,3-8:1:6,3-9:5:7,3-10:4:7,3-B:5:7,4-1:1:4,4-2:1:5,4-3:2:2,4-4:1:5,4-5:1:6,4-6:5:6,4-7:5:6,4-8:1:6,4-9:4:6,4-10:3:6,4-B:3:6,5-1:1:1,5-2:3:3,5-3:1:1,5-4:1:5,5-5:2:5,5-6:3:3,5-7:1:6,5-8:1:6,5-9:4:6,5-10:4:7,5-B:1:7,6-1:2:2,6-2:3:4,6-3:2:5,6-4:1:6,6-5:2:6,6-6:1:7,6-7:2:6,6-8:4:6,6-9:4:6,6-10:5:6,6-B:5:8,7-1:1:2,7-2:1:1,7-3:1:1,7-4:1:3,7-5:1:4,7-6:2:4,7-7:1:4,7-8:3:5,7-9:3:5,7-10:5:6,7-B:4:8';
    }
    function dailyTable() {
      return 'dawn-0:5:5,dawn-1:4:6,dawn-2:2:5,dawn-3:3:6,dawn-4:4:6,dawn-5:6:6,dawn-6:4:5,dawn-7:3:5,dawn-8:3:6,dawn-9:6:6,dawn-10:5:6,dawn-11:3:5,dawn-12:3:5,dawn-13:2:5,dawn-14:6:6,dawn-15:2:5,dawn-16:5:6,dawn-17:5:6,dawn-18:3:5,dawn-19:1:5,dawn-20:3:6,dawn-21:4:6,dawn-22:5:6,dawn-23:5:6,dawn-24:4:5,dawn-25:6:6,dawn-26:5:6,dawn-27:4:6,dawn-28:5:6,dawn-29:4:6,dawn-30:2:5,dawn-31:5:6,dawn-32:2:5,dawn-33:2:5,dawn-34:6:6,dawn-35:3:5,dawn-36:5:6,dawn-37:4:6,dawn-38:5:5,dawn-39:5:5,dawn-40:4:5,dawn-41:4:6,dawn-42:5:6,dawn-43:6:6,dawn-44:6:6,dawn-45:6:6,dawn-46:5:5,dawn-47:4:6,dawn-48:5:6,dawn-49:6:6,dawn-50:6:6,dawn-51:5:6,dawn-52:5:6,dawn-53:5:5,dawn-54:3:6,dawn-55:2:5,dawn-56:5:5,dawn-57:4:5,dawn-58:3:5,dawn-59:6:6,dawn-60:3:5,gloom-0:1:5,gloom-1:2:6,gloom-2:1:6,gloom-3:2:6,gloom-4:3:5,gloom-5:6:6,gloom-6:4:6,gloom-7:2:5,gloom-8:2:6,gloom-9:1:6,gloom-10:3:6,gloom-11:1:6,gloom-12:4:6,gloom-13:2:6,gloom-14:1:6,gloom-15:2:6,gloom-16:3:6,gloom-17:2:5,gloom-18:3:6,gloom-19:4:6,gloom-20:2:6,gloom-21:4:6,gloom-22:3:6,gloom-23:1:6,gloom-24:1:6,gloom-25:4:6,gloom-26:2:6,gloom-27:3:6,gloom-28:1:6,gloom-29:4:6,gloom-30:4:6,gloom-31:4:6,gloom-32:3:6,gloom-33:3:6,gloom-34:4:6,gloom-35:4:6,gloom-36:4:6,gloom-37:4:6,gloom-38:3:6,gloom-39:2:6,gloom-40:5:6,gloom-41:3:6,gloom-42:1:6,gloom-43:2:6,gloom-44:2:6,gloom-45:3:6,gloom-46:2:6,gloom-47:1:5,gloom-48:3:6,gloom-49:2:6,gloom-50:2:6,gloom-51:2:6,gloom-52:2:6,gloom-53:3:6,gloom-54:4:6,gloom-55:1:6,gloom-56:1:6,gloom-57:3:6,gloom-58:3:6,gloom-59:5:6,gloom-60:2:6,grove-0:3:6,grove-1:1:6,grove-2:1:6,grove-3:1:6,grove-4:2:6,grove-5:1:6,grove-6:1:6,grove-7:2:6,grove-8:1:6,grove-9:2:6,grove-10:2:6,grove-11:1:6,grove-12:2:6,grove-13:1:6,grove-14:2:6,grove-15:1:6,grove-16:1:6,grove-17:2:6,grove-18:2:6,grove-19:1:6,grove-20:1:6,grove-21:2:6,grove-22:2:6,grove-23:1:6,grove-24:2:6,grove-25:3:6,grove-26:1:6,grove-27:1:6,grove-28:1:6,grove-29:1:6,grove-30:2:6,grove-31:2:6,grove-32:2:6,grove-33:2:6,grove-34:1:6,grove-35:1:6,grove-36:1:6,grove-37:1:6,grove-38:1:6,grove-39:2:6,grove-40:1:6,grove-41:6:6,grove-42:1:6,grove-43:2:6,grove-44:1:6,grove-45:1:6,grove-46:1:6,grove-47:1:6,grove-48:2:6,grove-49:2:6,grove-50:1:6,grove-51:1:6,grove-52:1:6,grove-53:1:6,grove-54:2:6,grove-55:2:6,grove-56:1:6,grove-57:1:6,grove-58:1:6,grove-59:2:6,grove-60:1:6,meadow-0:6:6,meadow-1:3:6,meadow-2:1:6,meadow-3:4:6,meadow-4:1:6,meadow-5:3:6,meadow-6:4:6,meadow-7:3:6,meadow-8:1:6,meadow-9:3:6,meadow-10:5:6,meadow-11:3:6,meadow-12:3:6,meadow-13:4:6,meadow-14:1:6,meadow-15:3:6,meadow-16:4:6,meadow-17:3:6,meadow-18:4:6,meadow-19:5:6,meadow-20:5:6,meadow-21:4:6,meadow-22:1:6,meadow-23:3:6,meadow-24:2:6,meadow-25:5:6,meadow-26:1:6,meadow-27:4:6,meadow-28:3:6,meadow-29:2:6,meadow-30:2:6,meadow-31:4:6,meadow-32:4:6,meadow-33:3:6,meadow-34:4:6,meadow-35:2:6,meadow-36:2:5,meadow-37:2:5,meadow-38:4:6,meadow-39:4:6,meadow-40:2:6,meadow-41:4:6,meadow-42:5:6,meadow-43:1:6,meadow-44:3:6,meadow-45:3:6,meadow-46:4:6,meadow-47:2:6,meadow-48:1:6,meadow-49:1:6,meadow-50:3:6,meadow-51:2:6,meadow-52:1:6,meadow-53:4:6,meadow-54:2:6,meadow-55:3:6,meadow-56:1:6,meadow-57:1:6,meadow-58:3:6,meadow-59:3:5,meadow-60:2:6,peak-0:1:6,peak-1:2:6,peak-2:2:6,peak-3:2:6,peak-4:3:6,peak-5:4:6,peak-6:6:6,peak-7:1:5,peak-8:3:6,peak-9:1:6,peak-10:1:5,peak-11:4:6,peak-12:1:6,peak-13:1:6,peak-14:4:6,peak-15:3:6,peak-16:1:6,peak-17:1:6,peak-18:1:6,peak-19:2:6,peak-20:4:6,peak-21:1:6,peak-22:5:6,peak-23:1:6,peak-24:5:6,peak-25:1:6,peak-26:1:6,peak-27:1:6,peak-28:2:6,peak-29:5:6,peak-30:2:6,peak-31:3:6,peak-32:2:6,peak-33:4:6,peak-34:1:6,peak-35:1:6,peak-36:1:6,peak-37:5:6,peak-38:4:6,peak-39:1:6,peak-40:1:6,peak-41:2:6,peak-42:1:6,peak-43:4:6,peak-44:5:6,peak-45:2:6,peak-46:1:6,peak-47:3:6,peak-48:1:5,peak-49:4:6,peak-50:1:6,peak-51:4:6,peak-52:4:6,peak-53:3:6,peak-54:1:6,peak-55:1:6,peak-56:5:6,peak-57:2:6,peak-58:2:6,peak-59:5:6,peak-60:1:6,pond-0:1:6,pond-1:2:6,pond-2:2:6,pond-3:5:6,pond-4:1:6,pond-5:1:6,pond-6:4:6,pond-7:4:6,pond-8:3:6,pond-9:3:6,pond-10:2:6,pond-11:1:6,pond-12:6:6,pond-13:1:6,pond-14:2:6,pond-15:2:6,pond-16:1:6,pond-17:2:6,pond-18:1:6,pond-19:3:6,pond-20:5:6,pond-21:2:6,pond-22:1:6,pond-23:4:6,pond-24:1:6,pond-25:1:6,pond-26:2:6,pond-27:1:6,pond-28:1:6,pond-29:4:6,pond-30:5:6,pond-31:2:6,pond-32:1:6,pond-33:2:6,pond-34:6:6,pond-35:1:6,pond-36:1:6,pond-37:5:6,pond-38:1:6,pond-39:3:6,pond-40:5:6,pond-41:1:6,pond-42:1:6,pond-43:6:6,pond-44:4:6,pond-45:5:6,pond-46:2:6,pond-47:4:6,pond-48:1:6,pond-49:2:6,pond-50:1:6,pond-51:2:6,pond-52:2:6,pond-53:1:6,pond-54:2:6,pond-55:1:6,pond-56:2:6,pond-57:1:6,pond-58:3:6,pond-59:2:6,pond-60:5:6,ruins-0:2:6,ruins-1:2:6,ruins-2:1:6,ruins-3:4:6,ruins-4:5:6,ruins-5:2:6,ruins-6:3:6,ruins-7:3:6,ruins-8:5:6,ruins-9:3:6,ruins-10:4:6,ruins-11:3:6,ruins-12:4:6,ruins-13:3:6,ruins-14:2:6,ruins-15:3:6,ruins-16:4:6,ruins-17:3:6,ruins-18:3:6,ruins-19:4:6,ruins-20:3:6,ruins-21:4:6,ruins-22:2:6,ruins-23:3:5,ruins-24:3:6,ruins-25:3:6,ruins-26:2:6,ruins-27:4:6,ruins-28:2:6,ruins-29:3:6,ruins-30:3:6,ruins-31:4:6,ruins-32:4:6,ruins-33:2:6,ruins-34:1:6,ruins-35:4:6,ruins-36:2:6,ruins-37:2:6,ruins-38:2:6,ruins-39:2:6,ruins-40:3:6,ruins-41:1:6,ruins-42:4:6,ruins-43:3:6,ruins-44:3:6,ruins-45:3:6,ruins-46:2:6,ruins-47:3:6,ruins-48:6:6,ruins-49:3:6,ruins-50:4:6,ruins-51:4:6,ruins-52:2:6,ruins-53:4:6,ruins-54:6:6,ruins-55:3:6,ruins-56:4:6,ruins-57:2:6,ruins-58:4:6,ruins-59:3:6,ruins-60:6:6';
    }
    // END TABLES
  }
}
